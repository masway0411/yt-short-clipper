# YT-Short-Clipper Environment Variables
# =======================================
# Copy this file to .env and fill in your values

# Google Gemini API Key (required)
# Get your key at: https://aistudio.google.com/app/apikeys
GEMINI_APIKEY=your-gemini-api-key-here

# Optional: Anthropic API Key (for future Claude integration)
# ANTHROPIC_APIKEY=sk-ant-your-key-here

# Optional: Custom output directory
# OUTPUT_DIR=./output

# Optional: Default number of clips
# DEFAULT_NUM_CLIPS=5

# Optional: Whisper model size (tiny, base, small, medium, large)
# WHISPER_MODEL=base
